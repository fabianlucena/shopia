@backend_shopia_HostAddress = http://127.0.0.1:5085

###

# @name login
POST {{backend_shopia_HostAddress}}/v1/login/
Accept: application/json
Accept-Language: en-US,en;q=0.5
Content-Type: application/json

{
    "username": "admin",
    "password": "1234"
}

###

POST {{backend_shopia_HostAddress}}/v1/login-check/
Authorization: Bearer {{login.response.body.$.authorizationToken}}

###

POST {{backend_shopia_HostAddress}}/v1/my-email/
Authorization: Bearer {{login.response.body.$.authorizationToken}}
Accept: application/json
Accept-Language: en-US,en;q=0.5
Content-Type: application/json

{
    "email": "admin"
}

###

# @name mainVerificationToken
POST {{backend_shopia_HostAddress}}/v1/my-email/verify
Authorization: Bearer {{login.response.body.$.authorizationToken}}
Accept: application/json
Accept-Language: en-US,en;q=0.5
Content-Type: application/json

###

POST {{backend_shopia_HostAddress}}/{{mainVerificationToken.response.body.$.url}}
Accept: application/json
Accept-Language: en-US,en;q=0.5
